[Unit]
Description=terminal-hub: ttyd serving the hub page and its terminals
Wants=terminal-hub-assets.service

[Service]
# Localhost only. ttyd hands a shell to anyone who can reach it: publish it through something
# that authenticates, like `tailscale serve`, never directly. --check-origin refuses terminal
# connections opened by other websites in your browser. Each terminal runs terminal-hub with the
# page's ?arg= values (--url-arg).
ExecStart=ttyd --interface 127.0.0.1 --port 7682 --writable --check-origin --url-arg \
  --index %h/.local/share/terminal-hub/index.html %h/.local/bin/terminal-hub
WorkingDirectory=%h
Environment=TERM=xterm-256color
# Don't take the tmux server (and every session in it) down with ttyd.
KillMode=process
Restart=on-failure

[Install]
WantedBy=default.target
