# terminal-hub config: a bash file at ~/.config/terminal-hub/config. The picker reads it each
# time the hub opens; install.sh reads the app settings, so re-run it after changing those.

# The installable app.
HUB_NAME='terminal hub'               # home-screen name and page title
HUB_SHORT_NAME='hub'                  # label under the icon
HUB_APP_ID='hub'                      # the app's identity: change it and phones see a new app
HUB_DESCRIPTION='Every tmux session in one list'

# If this machine doesn't answer within 4 s, the installed app opens this URL instead, say the
# same hub on an always-on server. Empty turns it off.
HUB_FALLBACK=''
HUB_FALLBACK_NAME=''                  # shown while switching, e.g. 'the server'

# The picker.
HUB_PROMPT='hub > '
HUB_HEADER='tap a session or type to filter'

# Places whose tmux sessions are listed, in this order. The first is "here": /?arg=new and
# /?arg=NAME open there, and any place opens with /?arg=KEY:NAME. LABEL and COLOUR make its tag.
#   place KEY LABEL COLOUR local            tmux on this machine, as you
#   place KEY LABEL COLOUR ssh HOST [CMD]   tmux on HOST over ssh (key login); CMD runs it there,
#                                           e.g. `sudo -u USER -H` for another user's sessions
#   place KEY LABEL COLOUR via CMD          tmux through CMD, which runs a shell command string,
#                                           e.g. `sudo -n -u USER bash -c` for another local user
# The words of CMD can't contain spaces.
place here "$(hostname)" '#7ee787' local
# place server server '#ff7b72' ssh myserver
