#!/usr/bin/env bash
# terminal-hub: the tmux sessions of every place in ~/.config/terminal-hub/config.
#
#   terminal-hub KEY:NAME      attach to session NAME on place KEY, creating it if needed
#                              (NAME alone: the first place). The page's terminals run this.
#   terminal-hub --existing KEY:NAME   the same, but only if the session still exists (the page
#                              uses this to reconnect, so it never recreates an ended session)
#   terminal-hub --list        every place and its sessions, tab-separated (the page's list)
#   terminal-hub --unlock KEY  ask once for the passphrase of place KEY's ssh key
#   terminal-hub --rename KEY:NAME NEW   rename a session (the page's session menu runs this)
#   terminal-hub --kill KEY:NAME         end a session and everything running in it
#   terminal-hub --check       check the setup: tools, config, every place, services
#   terminal-hub               pick a session with fzf and attach (in an ordinary terminal)
#
# When a session closes, the attach tells the page why, with a private OSC 7766 sequence that
# other terminals ignore: "detached", "ended", or "lost" (the connection to the place dropped).
# --rename and --kill answer the same way: "ok", or "failed;MESSAGE".
#
# install.sh copies this to ~/.local/bin; edit the copy in the repo.
set -u
CONFIG=${TERMINAL_HUB_CONFIG:-$HOME/.config/terminal-hub/config}
RUN=${XDG_RUNTIME_DIR:-/tmp}/terminal-hub-$(id -u)

die() { echo "terminal-hub: $*" >&2; exit 1; }

KEY=() LABEL=() COLOUR=() KIND=() ARGS=()
place() {  # place KEY LABEL COLOUR local|ssh|via [ARGS...]: see config.example
  [[ $1 =~ ^[A-Za-z0-9_-]+$ ]] || die "place key '$1' in $CONFIG: use letters, digits, - and _"
  [[ ${4:-} =~ ^(local|ssh|via)$ ]] || die "place $1 in $CONFIG: kind must be local, ssh or via"
  KEY+=("$1") LABEL+=("$2") COLOUR+=("$3") KIND+=("$4") ARGS+=("${*:5}")
}
# shellcheck source=/dev/null
[[ -f $CONFIG ]] && source "$CONFIG"
((${#KEY[@]})) || place here "$(hostname)" '#7ee787' local

# Listing reuses one ssh connection per place for a minute, so the page can refresh often.
LIST_SSH=(-o BatchMode=yes -o ConnectTimeout=5 -o ControlMaster=auto -o "ControlPath=$RUN/ssh-%C"
  -o ControlPersist=60)
# The fields that can be empty go last: `read` with a tab IFS merges empty fields in between.
FMT='#{session_name}	#{session_windows}	#{session_attached}	#{prefix}	#{@hub-state}	#{@hub-state-at}'

# list I: place I's sessions as "name windows attached state state-at" lines (tab-separated).
# No tmux server means no sessions, not an error, hence the `exit 0`s. Returns 2 when ssh was
# refused because the key is locked (listing can't ask for a passphrase), 1 if unreachable.
list() {
  local a err rc
  read -ra a <<<"${ARGS[$1]}"
  case ${KIND[$1]} in
    local) tmux list-sessions -F "$FMT" 2>/dev/null; return 0 ;;
    via) "${a[@]}" "tmux list-sessions -F '$FMT' 2>/dev/null; exit 0" 2>/dev/null ;;
    ssh)
      (umask 077 && mkdir -p "$RUN")
      { err=$(timeout 10 ssh "${LIST_SSH[@]}" "${a[0]}" \
        "${a[*]:1} tmux list-sessions -F '$FMT' 2>/dev/null; exit 0" 2>&1 >&3 3>&-); } 3>&1
      rc=$?
      ((rc)) && [[ $err == *'Permission denied'* ]] && return 2
      ((rc)) && return 1
      return 0
      ;;
  esac
}

# list_all: list every place at once; results land in $TMPD/I (sessions) and $TMPD/I.rc.
list_all() {
  local i
  TMPD=$(mktemp -d)
  for i in "${!KEY[@]}"; do
    { list "$i" >"$TMPD/$i"; echo $? >"$TMPD/$i.rc"; } &
  done
  wait
}

cmd_list() {
  local i st name win att prefix state at
  list_all
  for i in "${!KEY[@]}"; do
    case $(<"$TMPD/$i.rc") in 0) st=ok ;; 2) st=locked ;; *) st=unreachable ;; esac
    printf 'place\t%s\t%s\t%s\t%s\n' "${KEY[i]}" "${LABEL[i]}" "${COLOUR[i]}" "$st"
    while IFS=$'\t' read -r name win att prefix state at; do
      [[ -n $name ]] && printf 'session\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${KEY[i]}" "$name" "$win" "$att" "$state" "$at" "$prefix"
    done <"$TMPD/$i"
  done
  rm -rf "$TMPD"
}

find_place() {
  local i
  for i in "${!KEY[@]}"; do [[ ${KEY[i]} == "$1" ]] && echo "$i" && return 0; done
  return 1
}

# Shell code, run in the place, that attaches to session $1 (creating it in that user's home:
# $HOME expands there), then says why it closed: it looks the session up by id, which survives a
# rename. It lingers a moment after that, or ttyd may notice the exit before it sends the last
# output. No single quotes: attach may wrap it in them.
attach_cmd() {
  local osc='printf "\033]7766;%s\007"' missing="tmux new-session -d -s $1 -c \"\$HOME\""
  [[ ${2:-} == existing ]] && missing="{ $osc ended; sleep 0.5; exit 0; }"
  printf '%s' "tmux has-session -t =$1 2>/dev/null || $missing;" \
    " id=\$(tmux display-message -p -t =$1: \"#{session_id}\"); [ -n \"\$id\" ] || id==$1;" \
    " tmux attach -t =$1;" \
    " if tmux has-session -t \"\$id\" 2>/dev/null; then $osc detached; else $osc ended; fi; sleep 0.5"
}

# attach I NAME [existing]: attach this terminal to session NAME in place I.
attach() {
  local a cmd
  cmd=$(attach_cmd "$2" "${3:-}")
  read -ra a <<<"${ARGS[$1]}"
  case ${KIND[$1]} in
    local) exec sh -c "$cmd" ;;
    via) exec "${a[@]}" "$cmd" ;;
    ssh)
      ((${#a[@]} > 1)) && cmd="${a[*]:1} sh -c '$cmd'"
      ssh -t -o ConnectTimeout=6 -o ServerAliveInterval=15 "${a[0]}" "$cmd"
      (($? == 255)) && { echo "lost the connection to ${LABEL[$1]}"; printf '\e]7766;lost\a'; sleep 0.5; }
      exit 0
      ;;
  esac
}

# First of shell, shell-2, shell-3... not among the session names on stdin.
unique() {
  local taken name=shell i=2
  taken=$(cut -f1)
  while grep -qxF -- "$name" <<<"$taken"; do name="shell-$((i++))"; done
  echo "$name"
}

# target NAME | KEY:NAME: sets I (the place's index) and NAME. Returns 1 for an unknown place.
target() {
  I=0 NAME=$1
  [[ $1 == *:* ]] || return 0
  NAME=${1#*:}
  I=$(find_place "${1%%:*}")
}
# Names the hub attaches to and creates; they go into shell code unquoted.
NAME_RE='^[A-Za-z0-9_-]{1,32}$'
NAME_RULE='use 1-32 letters, digits, - and _'

# go NAME | KEY:NAME | KEY:new [existing]
go() {
  target "$1" || die "no place called ${1%%:*} in $CONFIG"
  [[ $NAME == new ]] && NAME=$(list "$I" | unique)
  [[ $NAME =~ $NAME_RE ]] || die "session name '$NAME': $NAME_RULE"
  attach "$I" "$NAME" "${2:-}"
}

# in_place I CODE: run a short command line in place I, without a terminal. CODE goes through
# exactly one shell there (sh -c, the via command, or the ssh login shell): see q.
in_place() {
  local a
  read -ra a <<<"${ARGS[$1]}"
  case ${KIND[$1]} in
    local) sh -c "$2" ;;
    via) "${a[@]}" "$2" ;;
    ssh)
      (umask 077 && mkdir -p "$RUN")
      timeout 10 ssh "${LIST_SSH[@]}" "${a[0]}" "${a[*]:1} $2"
      ;;
  esac
}

# q STRING: STRING single-quoted for that one shell, so any session name is safe in CODE.
q() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

# answer STATUS OUTPUT: tell the page how it went (OSC 7766 "ok" or "failed;MESSAGE").
answer() {
  if (($1 == 0)); then printf '\e]7766;ok\a'
  else printf '\e]7766;failed;%s\a' "$(printf '%s' "${2:-failed}" | tr -d '\000-\037' | head -c 200)"; fi
  sleep 0.5  # as in attach_cmd: let ttyd send it before the exit
  exit 0
}

# An existing session's name may be anything tmux allows (it's quoted); a new one follows NAME_RE.
cmd_rename() {
  local out
  target "${1:-}" || answer 1 "no place called ${1%%:*}"
  [[ -n $NAME && $NAME != *[[:cntrl:]]* ]] || answer 1 "no session named '$NAME'"
  [[ ${2:-} =~ $NAME_RE ]] || answer 1 "the new name: $NAME_RULE"
  out=$(in_place "$I" "tmux rename-session -t $(q "=$NAME") $2" 2>&1)
  answer $? "$out"
}

cmd_kill() {
  local out
  target "${1:-}" || answer 1 "no place called ${1%%:*}"
  [[ -n $NAME && $NAME != *[[:cntrl:]]* ]] || answer 1 "no session named '$NAME'"
  out=$(in_place "$I" "tmux kill-session -t $(q "=$NAME")" 2>&1)
  answer $? "$out"
}

cmd_unlock() {
  local i a
  i=$(find_place "${1:-}") || die "no place called ${1:-} in $CONFIG"
  [[ ${KIND[i]} == ssh ]] || die "${LABEL[i]} isn't an ssh place"
  read -ra a <<<"${ARGS[i]}"
  echo "Unlocking the ssh key for ${LABEL[i]} (${a[0]})."
  if ssh -o ConnectTimeout=6 "${a[0]}" true; then
    printf '\e]7766;unlocked\a'
    sleep 0.5
  else
    echo "Still locked."
    printf '\e]7766;failed\a'
    sleep 2
  fi
}

cmd_check() {
  local ok=1 i n st t
  say() { printf '  %-10s %s\n' "$1" "$2"; }
  echo "tools"
  for t in tmux ttyd python3; do
    if command -v "$t" >/dev/null; then say "$t" "$("$t" -V 2>/dev/null || "$t" --version 2>/dev/null | head -1)"
    else say "$t" "missing"; ok=0; fi
  done
  if command -v fzf >/dev/null; then say fzf "found (optional: the command-line picker)"
  else say fzf "not found (optional: the command-line picker)"; fi
  echo "config"
  if [[ -f $CONFIG ]]; then say file "$CONFIG"; else say file "missing: $CONFIG (using one place: this machine)"; fi
  echo "places"
  list_all
  for i in "${!KEY[@]}"; do
    n=$(grep -c . "$TMPD/$i")
    case $(<"$TMPD/$i.rc") in
      0) st="ok, $n session$( ((n == 1)) || echo s)" ;;
      2) st="ssh key locked: run terminal-hub --unlock ${KEY[i]}"; ok=0 ;;
      *) st="unreachable (${KIND[i]} ${ARGS[i]})"; ok=0 ;;
    esac
    say "${KEY[i]}" "$st"
  done
  rm -rf "$TMPD"
  if command -v systemctl >/dev/null; then
    echo "services"
    for t in terminal-hub terminal-hub-assets; do say "$t" "$(systemctl --user is-active "$t" 2>/dev/null)"; done
  fi
  echo "publish (tailnet only)"
  echo "  tailscale serve --bg --set-path / http://127.0.0.1:7682"
  echo "  tailscale serve --bg --set-path /assets http://127.0.0.1:7683"
  ((ok))
}

# The command-line picker: every session in one fzf list.
cmd_pick() {
  local i rows pick name win
  command -v fzf >/dev/null || die "the picker needs fzf; or attach directly: terminal-hub KEY:NAME"
  list_all
  rows=$(for i in "${!KEY[@]}"; do
    while IFS=$'\t' read -r name win _; do
      [[ -n $name ]] && printf '%s:%s\t%-12s %s  (%s win)\n' "${KEY[i]}" "$name" "${LABEL[i]}" "$name" "$win"
    done <"$TMPD/$i"
    [[ $(<"$TMPD/$i.rc") == 0 ]] && printf '%s:new\t%-12s + new shell\n' "${KEY[i]}" "${LABEL[i]}"
  done)
  rm -rf "$TMPD"
  pick=$(fzf --delimiter=$'\t' --with-nth=2 --reverse --prompt='session > ' <<<"$rows") || exit 0
  go "${pick%%$'\t'*}"
}

case ${1:-} in
  --list) cmd_list ;;
  --existing) go "${2:-}" existing ;;
  --unlock) cmd_unlock "${2:-}" ;;
  --rename) cmd_rename "${2:-}" "${3:-}" ;;
  --kill) cmd_kill "${2:-}" ;;
  --check) cmd_check ;;
  -h | --help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//' ;;
  '') cmd_pick ;;
  -*) die "unknown option $1 (see terminal-hub --help)" ;;
  *) go "$1" ;;
esac
