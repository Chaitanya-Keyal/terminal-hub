#!/usr/bin/env bash
# terminal-hub: the tmux sessions of every place in ~/.config/terminal-hub/config.
#
#   terminal-hub KEY:NAME      attach to session NAME on place KEY, creating it if needed
#                              (NAME alone: the first place). The page's terminals run this.
#   terminal-hub --existing KEY:NAME   the same, but only if the session still exists (the page
#                              uses this to reconnect, so it never recreates an ended session)
#   terminal-hub --list [KEY...]   the categories, then every place (or just these) and its
#                              sessions, tab-separated: the page's list
#   terminal-hub --config      the same without listing sessions (no network: just the config)
#   terminal-hub --unlock KEY  ask once for the passphrase of place KEY's ssh key
#   terminal-hub --rename KEY:NAME NEW   rename a session (the page's session menu runs this)
#   terminal-hub --kill KEY:NAME         end a session and everything running in it
#   terminal-hub --category KEY:NAME CAT put a session in category CAT (- for none)
#   terminal-hub --new-category LABEL ICON [PATTERN...]   make a category (the page does this)
#   terminal-hub --edit-category KEY LABEL ICON           rename one made that way
#   terminal-hub --delete-category KEY                    and remove it
#   terminal-hub --order GROUP KEY:NAME...   the order of a group's sessions (dragged on the page)
#   terminal-hub --receive KEY FILENAME   save stdin as a file in place KEY, print its path (the
#                              page's "Send a file", through server.py)
#   terminal-hub --check       check the setup: tools, config, every place, services
#   terminal-hub               pick a session with fzf and attach (in an ordinary terminal)
#
# When a session closes, the attach tells the page why, with a private OSC 7766 sequence that
# other terminals ignore: "detached", "ended", or "lost" (the connection to the place dropped).
# The page's commands (--rename, --kill, the category ones) answer the same way: "ok[;MESSAGE]"
# or "failed;MESSAGE".
#
# install.sh copies this to ~/.local/bin; edit the copy in the repo.
set -u
CONFIG=${TERMINAL_HUB_CONFIG:-$HOME/.config/terminal-hub/config}  # the tests use their own
RUN=${XDG_RUNTIME_DIR:-/tmp}/terminal-hub-$(id -u)

die() { echo "terminal-hub: $*" >&2; exit 1; }
# index_of VALUE ITEMS...: the index of VALUE among ITEMS, or fail.
index_of() {
  local v=$1 i=0 x
  shift
  for x; do [[ $x == "$v" ]] && echo "$i" && return 0; i=$((i + 1)); done
  return 1
}
# Session names the hub attaches to and creates (they go into shell code unquoted), and category
# keys. Not starting with -, which tmux would take for an option.
NAME_RE='^[A-Za-z0-9_][A-Za-z0-9_-]{0,31}$'
NAME_RULE="use 1-32 letters, digits, - and _ (not starting with -)"

# The config (see config.example) calls these, and may set HUB_PORT (for --check).
HUB_PORT=7682
KEY=() LABEL=() COLOUR=() KIND=() ARGS=()
place() {  # place KEY LABEL COLOUR local|ssh|via [ARGS...]
  [[ $1 =~ ^[A-Za-z0-9_-]+$ ]] || die "place key '$1' in $CONFIG: use letters, digits, - and _"
  [[ ${4:-} =~ ^(local|ssh|via)$ ]] || die "place $1 in $CONFIG: kind must be local, ssh or via"
  KEY+=("$1") LABEL+=("$2") COLOUR+=("$3") KIND+=("$4") ARGS+=("${*:5}")
}
declare -A ICON=()
icon() { ICON[$1]=${2:-}; }  # icon KEY NAME: place KEY's icon (a Lucide name, or an emoji)
CAT_KEY=() CAT_LABEL=() CAT_ICON=() CAT_PATS=() CAT_PAGE=()
category() {  # category KEY LABEL ICON [PATTERN...]
  [[ $1 =~ $NAME_RE ]] || die "category key '$1' in $CONFIG: $NAME_RULE"
  local IFS=$'\n'
  CAT_KEY+=("$1") CAT_LABEL+=("${2:-$1}") CAT_ICON+=("${3:-}") CAT_PATS+=("${*:4}") CAT_PAGE+=(0)
}
# shellcheck source=/dev/null
[[ -f $CONFIG ]] && source "$CONFIG"
((${#KEY[@]})) || place here "$(hostname)" '#7ee787' local

# Categories made on the page live in a data file next to the config (never run as code), one
# per line: KEY, LABEL, ICON ("-" for none), then patterns, tab-separated. The config's come first.
CATS=${CONFIG%/*}/categories
category_index() { index_of "$1" "${CAT_KEY[@]}"; }  # category_index KEY: its index, or fail
if [[ -f $CATS ]]; then
  while IFS=$'\t' read -r -a f; do
    if [[ ! ${f[0]:-} =~ $NAME_RE ]] || category_index "${f[0]}" >/dev/null; then continue; fi
    [[ ${f[2]:--} == - ]] && f[2]=''
    category "${f[@]:0:3}" "${f[@]:3}"
    CAT_PAGE[-1]=1
  done <"$CATS"
fi
# The order you dragged sessions into on the page, per group of the list ("c:KEY" a category,
# "p:KEY" a place), also a data file: GROUP, then KEY:NAME..., tab-separated, one group per line.
ORDER=${CONFIG%/*}/order
ORDER_RE=$'^[cp]:[A-Za-z0-9_-]{1,32}\t'

# Listing reuses one ssh connection per place for a minute, so the page can refresh often.
LIST_SSH=(-o BatchMode=yes -o ConnectTimeout=5 -o ControlMaster=auto -o "ControlPath=$RUN/ssh-%C"
  -o ControlPersist=60)
# Tab-separated. `read` merges empty fields, so the ones that can be empty start with "=".
FMT=$'#{session_name}\t#{session_windows}\t#{session_attached}\t#{prefix}\t#{session_path}\t=#{@hub-category}\t=#{@hub-state}\t=#{@hub-state-at}'

# list I: place I's sessions, one FMT line each.
# No tmux server means no sessions, not an error, hence the `exit 0`s. Returns 2 when ssh was
# refused because the key is locked (listing can't ask for a passphrase), 1 if unreachable.
list() {
  local a err rc
  read -ra a <<<"${ARGS[$1]}"
  case ${KIND[$1]} in
    local) tmux list-sessions -F "$FMT" 2>/dev/null; return 0 ;;
    via) timeout 10 "${a[@]}" "tmux list-sessions -F '$FMT' 2>/dev/null; exit 0" 2>/dev/null ;;
    ssh)
      (umask 077 && mkdir -p "$RUN")
      { err=$(timeout 10 ssh "${LIST_SSH[@]}" "${a[0]}" \
        "${a[*]:1} tmux list-sessions -F '$FMT' 2>/dev/null; exit 0" 2>&1 >&3 3>&-); } 3>&1
      rc=$?
      ((rc)) && [[ $err == *'Permission denied'* ]] && return 2
      ((rc)) && return 1
      return 0
      ;;
  esac
}

# list_all [I...]: list every place (or these) at once; results land in $TMPD/I and $TMPD/I.rc.
list_all() {
  local i want=("$@")
  ((${#want[@]})) || want=("${!KEY[@]}")
  TMPD=$(mktemp -d)
  for i in "${want[@]}"; do
    { list "$i" >"$TMPD/$i"; echo $? >"$TMPD/$i.rc"; } &
  done
  wait
}

# category_of I NAME PATH EXPLICIT: sets CAT to the session's category key, or "". One set from its menu
# (EXPLICIT; "-" means none) wins; then the first category with a matching pattern: a pattern
# with a / matches the folder the session started in, one with a : matches PLACE:NAME, and any
# other matches NAME.
category_of() {
  local c pat target
  CAT=''
  if [[ -n $4 ]]; then
    category_index "$4" >/dev/null && CAT=$4 && return
    [[ $4 == - ]] && return
  fi
  for c in "${!CAT_KEY[@]}"; do
    while IFS= read -r pat; do
      [[ -n $pat ]] || continue
      case $pat in */*) target=$3 ;; *:*) target=${KEY[$1]}:$2 ;; *) target=$2 ;; esac
      # shellcheck disable=SC2053  # the pattern is a glob on purpose
      [[ $target == $pat ]] && CAT=${CAT_KEY[c]} && return
    done <<<"${CAT_PATS[c]}"
  done
}

# The page's list: the categories, then each place (all, or the indexes given) and its sessions.
# With LIST=0 (--config), places come without sessions and with the state "pending".
cmd_list() {
  local i c st name win att prefix path cat state at CAT line want=("$@")
  ((${#want[@]})) || want=("${!KEY[@]}")
  for c in "${!CAT_KEY[@]}"; do
    printf 'category\t%s\t%s\t%s\t%s\n' "${CAT_KEY[c]}" "${CAT_LABEL[c]}" "${CAT_ICON[c]}" \
      "$( ((CAT_PAGE[c])) && echo page || echo config)"
  done
  if [[ -f $ORDER ]]; then
    while IFS= read -r line; do [[ $line =~ $ORDER_RE ]] && printf 'order\t%s\n' "$line"; done <"$ORDER"
  fi
  ((LIST)) && list_all "${want[@]}"
  for i in "${want[@]}"; do
    st=pending
    ((LIST)) && case $(<"$TMPD/$i.rc") in 0) st=ok ;; 2) st=locked ;; *) st=unreachable ;; esac
    printf 'place\t%s\t%s\t%s\t%s\t%s\n' "${KEY[i]}" "${LABEL[i]}" "${COLOUR[i]}" "$st" "${ICON[${KEY[i]}]:-}"
    ((LIST)) || continue
    while IFS=$'\t' read -r name win att prefix path cat state at; do
      [[ -n $name ]] || continue
      category_of "$i" "$name" "$path" "${cat#=}"
      printf 'session\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${KEY[i]}" "$name" "$win" "$att" "${state#=}" "${at#=}" \
        "$prefix" "$CAT" "$path"
    done <"$TMPD/$i"
  done
  ((LIST)) && rm -rf "$TMPD"
  return 0
}

find_place() { index_of "$1" "${KEY[@]}"; }

# Shell code, run in the place, that attaches to session $1 (creating it in that user's home:
# $HOME expands there), then says why it closed: it looks the session up by id, which survives a
# rename. It lingers a moment after that, or ttyd may notice the exit before it sends the last
# output. No single quotes: attach may wrap it in them.
attach_cmd() {
  local osc='printf "\033]7766;%s\007"' missing="tmux new-session -d -s $1 -c \"\$HOME\""
  [[ ${2:-} == existing ]] && missing="{ $osc ended; sleep 0.5; exit 0; }"
  printf '%s' "tmux has-session -t =$1 2>/dev/null || $missing;" \
    " id=\$(tmux display-message -p -t =$1: \"#{session_id}\"); [ -n \"\$id\" ] || id==$1;" \
    " tmux attach -t =$1;" \
    " if tmux has-session -t \"\$id\" 2>/dev/null; then $osc detached; else $osc ended; fi; sleep 0.5"
}

# attach I NAME [existing]: attach this terminal to session NAME in place I.
attach() {
  local a cmd
  cmd=$(attach_cmd "$2" "${3:-}")
  read -ra a <<<"${ARGS[$1]}"
  case ${KIND[$1]} in
    local) exec sh -c "$cmd" ;;
    via) exec "${a[@]}" "$cmd" ;;
    ssh)
      ((${#a[@]} > 1)) && cmd="${a[*]:1} sh -c '$cmd'"
      ssh -t -o ConnectTimeout=6 -o ServerAliveInterval=15 "${a[0]}" "$cmd"
      (($? == 255)) && { echo "lost the connection to ${LABEL[$1]}"; printf '\e]7766;lost\a'; sleep 0.5; }
      exit 0
      ;;
  esac
}

# First of shell, shell-2, shell-3... not among the session names on stdin.
unique() {
  local taken name=shell i=2
  taken=$(cut -f1)
  while grep -qxF -- "$name" <<<"$taken"; do name="shell-$((i++))"; done
  echo "$name"
}

# target NAME | KEY:NAME: sets I (the place's index) and NAME. Returns 1 for an unknown place.
target() {
  I=0 NAME=$1
  [[ $1 == *:* ]] || return 0
  NAME=${1#*:}
  I=$(find_place "${1%%:*}")
}

# go NAME | KEY:NAME | KEY:new [existing]
go() {
  target "$1" || die "no place called ${1%%:*} in $CONFIG"
  [[ $NAME == new ]] && NAME=$(list "$I" | unique)
  [[ $NAME =~ $NAME_RE ]] || die "session name '$NAME': $NAME_RULE"
  attach "$I" "$NAME" "${2:-}"
}

# in_place I CODE: run a short command line in place I, without a terminal. CODE goes through
# exactly one shell there (sh -c, the via command, or the ssh login shell): see q.
in_place() {
  local a
  read -ra a <<<"${ARGS[$1]}"
  case ${KIND[$1]} in
    local) sh -c "$2" ;;
    via) "${a[@]}" "$2" ;;
    ssh)
      (umask 077 && mkdir -p "$RUN")
      timeout 10 ssh "${LIST_SSH[@]}" "${a[0]}" "${a[*]:1} $2"
      ;;
  esac
}

# q STRING: STRING single-quoted for that one shell, so any session name is safe in CODE.
q() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

# answer STATUS OUTPUT: tell the page how it went (OSC 7766 "ok" or "failed;MESSAGE").
answer() {
  if (($1 == 0)); then printf '\e]7766;ok%s\a' "${2:+;$2}"
  else printf '\e]7766;failed;%s\a' "$(printf '%s' "${2:-failed}" | tr -d '\000-\037' | head -c 200)"; fi
  sleep 0.5  # as in attach_cmd: let ttyd send it before the exit
  exit 0
}

# session KEY:NAME: sets I and NAME for the page's session commands, or answers why not. An
# existing session's name may be anything tmux allows (it's quoted); a new one follows NAME_RE.
session() {
  target "$1" || answer 1 "no place called ${1%%:*}"
  [[ -n $NAME && $NAME != *[[:cntrl:]]* ]] || answer 1 "no session named '$NAME'"
}

cmd_rename() {
  local out
  session "${1:-}"
  [[ ${2:-} =~ $NAME_RE ]] || answer 1 "the new name: $NAME_RULE"
  out=$(in_place "$I" "tmux rename-session -t $(q "=$NAME") $2" 2>&1) || answer 1 "$out"
  order_rename "${KEY[I]}:$NAME" "${KEY[I]}:$2"
  answer 0
}

cmd_category() {
  local out
  session "${1:-}"
  [[ ${2:-} == - ]] || category_index "${2:-}" >/dev/null || answer 1 "no category called '${2:-}'"
  out=$(in_place "$I" "tmux set-option -t $(q "=$NAME:") @hub-category $2" 2>&1) || answer 1 "$out"
  answer 0
}

# The data files (CATS, ORDER). Writes take a lock on the config's folder, and replace the file in
# one step.
data_lock() {
  mkdir -p "${CONFIG%/*}" && exec 9<"${CONFIG%/*}" && { command -v flock >/dev/null || return 0; flock 9; }
}
# data_put FILE KEY [LINE]: KEY's line becomes LINE (or goes, without one); a new KEY's is added.
data_put() {
  local tmp line found=0
  tmp=$(mktemp "$1.XXXXXX") || return 1
  if [[ -f $1 ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      if [[ ${line%%$'\t'*} == "$2" ]]; then
        ((found)) || [[ -z ${3:-} ]] || printf '%s\n' "$3"
        found=1
      else
        printf '%s\n' "$line"
      fi
    done <"$1" >"$tmp"
  fi
  ((found)) || [[ -z ${3:-} ]] || printf '%s\n' "$3" >>"$tmp"
  mv "$tmp" "$1"
}
valid_label() { [[ -n $1 && ${#1} -le 40 && $1 != *[[:cntrl:]]* ]]; }
# A Lucide name, or something short like an emoji.
valid_icon() { [[ $1 =~ ^[A-Za-z0-9-]{1,32}$ ]] || [[ -n $1 && ${#1} -le 16 && $1 != *[[:cntrl:]]* && $1 != *' '* ]]; }

cmd_new_category() {
  local label=${1:-} icon=${2:-} base key i=2 p line
  valid_label "$label" || answer 1 "a name of 1-40 characters"
  valid_icon "$icon" || answer 1 "an icon name or an emoji"
  for p in "${@:3}"; do [[ -n $p && $p != *[[:cntrl:]]* ]] || answer 1 "a pattern with a control character"; done
  base=${label,,} base=${base//[^a-z0-9]/-}
  while [[ $base == *--* ]]; do base=${base//--/-}; done
  base=${base#-} base=${base%-} base=${base:0:24}
  [[ -n $base ]] || base=category
  data_lock || answer 1 "can't lock ${CONFIG%/*}"
  key=$base
  while category_index "$key" >/dev/null || grep -q "^$key"$'\t' "$CATS" 2>/dev/null; do key=$base-$((i++)); done
  line=$key$'\t'$label$'\t'$icon
  for p in "${@:3}"; do line+=$'\t'$p; done
  data_put "$CATS" "$key" "$line" || answer 1 "can't write $CATS"
  answer 0 "$key"
}

# page_category KEY: sets C to the index of KEY, a category made on the page, or answers why not.
page_category() {
  C=$(category_index "$1") || answer 1 "no category called '$1'"
  ((CAT_PAGE[C])) || answer 1 "'$1' is in the config file: change it there"
}

cmd_edit_category() {
  local C line p
  page_category "${1:-}"
  valid_label "${2:-}" || answer 1 "a name of 1-40 characters"
  valid_icon "${3:-}" || answer 1 "an icon name or an emoji"
  line=$1$'\t'$2$'\t'$3
  while IFS= read -r p; do [[ -n $p ]] && line+=$'\t'$p; done <<<"${CAT_PATS[C]}"
  if ! data_lock || ! data_put "$CATS" "$1" "$line"; then answer 1 "can't write $CATS"; fi
  answer 0
}

cmd_delete_category() {
  local C
  page_category "${1:-}"
  if ! data_lock || ! data_put "$CATS" "$1"; then answer 1 "can't write $CATS"; fi
  answer 0
}

# --order GROUP KEY:NAME...: the page's new order for one group of the list.
cmd_order() {
  local line=${1:-} t
  [[ $line$'\t' =~ $ORDER_RE ]] || answer 1 "no group called '$line'"
  (($# >= 2 && $# <= 501)) || answer 1 "1 to 500 sessions"
  for t in "${@:2}"; do
    [[ $t =~ ^[A-Za-z0-9_-]+:. && ${#t} -le 100 && $t != *[[:cntrl:]]* ]] || answer 1 "no session called '$t'"
    line+=$'\t'$t
  done
  if ! data_lock || ! data_put "$ORDER" "$1" "$line"; then answer 1 "can't write $ORDER"; fi
  answer 0
}

# order_rename OLD NEW: a renamed session keeps its place in the order.
order_rename() {
  local tmp line f i
  [[ -f $ORDER ]] && data_lock && tmp=$(mktemp "$ORDER.XXXXXX") || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    IFS=$'\t' read -r -a f <<<"$line"
    for i in "${!f[@]}"; do [[ ${f[i]} == "$1" ]] && f[i]=$2; done
    (IFS=$'\t' && printf '%s\n' "${f[*]}")
  done <"$ORDER" >"$tmp"
  mv "$tmp" "$ORDER"
}

cmd_kill() {
  local out
  session "${1:-}"
  out=$(in_place "$I" "tmux kill-session -t $(q "=$NAME")" 2>&1) || answer 1 "$out"
  answer 0
}

cmd_unlock() {
  local i a
  i=$(find_place "${1:-}") || die "no place called ${1:-} in $CONFIG"
  [[ ${KIND[i]} == ssh ]] || die "${LABEL[i]} isn't an ssh place"
  read -ra a <<<"${ARGS[i]}"
  echo "Unlocking the ssh key for ${LABEL[i]} (${a[0]})."
  if ssh -o ConnectTimeout=6 "${a[0]}" true; then
    printf '\e]7766;unlocked\a'
    sleep 0.5
  else
    echo "Still locked."
    printf '\e]7766;failed\a'
    sleep 2
  fi
}

cmd_check() {
  local ok=1 i n st t
  say() { printf '  %-10s %s\n' "$1" "$2"; }
  echo "tools"
  for t in tmux ttyd python3; do
    if command -v "$t" >/dev/null; then say "$t" "$("$t" -V 2>/dev/null || "$t" --version 2>/dev/null | head -1)"
    else say "$t" "missing"; ok=0; fi
  done
  if command -v fzf >/dev/null; then say fzf "found (optional: the command-line picker)"
  else say fzf "not found (optional: the command-line picker)"; fi
  echo "config"
  if [[ -f $CONFIG ]]; then say file "$CONFIG"; else say file "missing: $CONFIG (using one place: this machine)"; fi
  echo "places"
  list_all
  for i in "${!KEY[@]}"; do
    n=$(grep -c . "$TMPD/$i")
    case $(<"$TMPD/$i.rc") in
      0) st="ok, $n session$( ((n == 1)) || echo s)" ;;
      2) st="ssh key locked: run terminal-hub --unlock ${KEY[i]}"; ok=0 ;;
      *) st="unreachable (${KIND[i]} ${ARGS[i]})"; ok=0 ;;
    esac
    say "${KEY[i]}" "$st"
  done
  rm -rf "$TMPD"
  if command -v systemctl >/dev/null; then
    echo "services"
    for t in terminal-hub terminal-hub-assets; do say "$t" "$(systemctl --user is-active "$t" 2>/dev/null)"; done
  fi
  echo "ports (publish both through something that authenticates: docs/install.md)"
  for t in "ttyd $HUB_PORT" "files $((HUB_PORT + 1))"; do
    if (exec 3<>"/dev/tcp/127.0.0.1/${t#* }") 2>/dev/null; then say "${t% *}" "127.0.0.1:${t#* } answers"
    else say "${t% *}" "nothing on 127.0.0.1:${t#* }"; ok=0; fi
  done
  ((ok))
}

# --receive KEY FILENAME: stdin into a file in place KEY, in a private folder for files sent from
# the page; prints its path, for the page to type. The name keeps letters, digits, . - and _, and
# gets a number in front if it's taken. The code goes through one shell there: no single quotes.
cmd_receive() {
  local i a name code
  i=$(find_place "${1:-}") || die "no place called ${1:-}"
  name=${2//[^A-Za-z0-9._-]/_}
  while [[ $name == [.-]* ]]; do name=${name:1}; done
  name=${name:0:80}
  name=${name:-file}
  code="d=\"\${TMPDIR:-/tmp}/terminal-hub-files-\$(id -u)\"; umask 077; mkdir -p \"\$d\" && [ -O \"\$d\" ] || exit 1;"
  code+=" f=\"\$d/$name\" n=2; while [ -e \"\$f\" ]; do f=\"\$d/\$n-$name\" n=\$((n + 1)); done; cat >\"\$f\" && echo \"\$f\""
  read -ra a <<<"${ARGS[i]}"
  case ${KIND[i]} in
    local) sh -c "$code" ;;
    via) "${a[@]}" "$code" ;;
    ssh)
      (umask 077 && mkdir -p "$RUN")
      timeout 300 ssh "${LIST_SSH[@]}" "${a[0]}" "${a[*]:1} sh -c '$code'"
      ;;
  esac
}

# The command-line picker: every session in one fzf list.
cmd_pick() {
  local i rows pick name win
  command -v fzf >/dev/null || die "the picker needs fzf; or attach directly: terminal-hub KEY:NAME"
  list_all
  rows=$(for i in "${!KEY[@]}"; do
    while IFS=$'\t' read -r name win _; do
      [[ -n $name ]] && printf '%s:%s\t%-12s %s  (%s win)\n' "${KEY[i]}" "$name" "${LABEL[i]}" "$name" "$win"
    done <"$TMPD/$i"
    [[ $(<"$TMPD/$i.rc") == 0 ]] && printf '%s:new\t%-12s + new shell\n' "${KEY[i]}" "${LABEL[i]}"
  done)
  rm -rf "$TMPD"
  pick=$(fzf --delimiter=$'\t' --with-nth=2 --reverse --prompt='session > ' <<<"$rows") || exit 0
  go "${pick%%$'\t'*}"
}

# --list takes place keys; cmd_list works with indexes.
indexes() {
  local k
  IDX=()
  for k in "$@"; do IDX+=("$(find_place "$k")") || die "no place called $k in $CONFIG"; done
}

LIST=1
case ${1:-} in
  --list) indexes "${@:2}" && cmd_list "${IDX[@]}" ;;
  --config) LIST=0 cmd_list ;;
  --category) cmd_category "${2:-}" "${3:-}" ;;
  --new-category) cmd_new_category "${@:2}" ;;
  --edit-category) cmd_edit_category "${2:-}" "${3:-}" "${4:-}" ;;
  --delete-category) cmd_delete_category "${2:-}" ;;
  --order) cmd_order "${@:2}" ;;
  --existing) go "${2:-}" existing ;;
  --unlock) cmd_unlock "${2:-}" ;;
  --rename) cmd_rename "${2:-}" "${3:-}" ;;
  --kill) cmd_kill "${2:-}" ;;
  --receive) cmd_receive "${2:-}" "${3:-}" ;;
  --check) cmd_check ;;
  -h | --help) sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//' ;;
  '') cmd_pick ;;
  -*) die "unknown option $1 (see terminal-hub --help)" ;;
  *) go "$1" ;;
esac
